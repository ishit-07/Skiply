{
  "manifest_version": 3,
  "name": "Skiply",
  "version": "0.1.0",
  "description": "Automatically skip intros, recaps, and repetitive content while you stream.",
  "icons": {
    "16": "icons/skiply-16.png",
    "32": "icons/skiply-32.png",
    "48": "icons/skiply-48.png",
    "128": "icons/skiply-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Skiply",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/skiply-16.png",
      "32": "icons/skiply-32.png",
      "48": "icons/skiply-48.png",
      "128": "icons/skiply-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
